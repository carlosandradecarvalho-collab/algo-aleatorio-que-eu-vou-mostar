const contactForm = document.getElementById("contactForm");
    const formFeedback = document.getElementById("formFeedback");

    // Intercepta o envio do formulário
    contactForm.addEventListener("submit", function (event) {
        event.preventDefault(); // Impede a página de recarregar

        // Captura os dados preenchidos
        const userName = document.getElementById("name").value;
        const userEmail = document.getElementById("email").value;
        const userMessage = document.getElementById("message").value;

        // Validação simples extra antes do envio simulado
        if (userName && userEmail && userMessage) {
            
            // Oculta o formulário de forma suave
            contactForm.style.display = "none";

            // Exibe a mensagem de sucesso e acolhimento
            formFeedback.innerHTML = `
                <div class="success-message">
                    Obrigado pelo seu contato, ${userName}. <br>
                    Sua mensagem foi recebida com segurança. Lembre-se: você não está sozinho(a)! <br>
                    <small>Nota: Isto é uma simulação de frontend. Em um site real, esses dados seriam enviados a um servidor seguro.</small>
                </div>
            `;
            formFeedback.classList.remove("hidden");
        }
    });
});
